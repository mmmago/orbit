<?xml version="1.0" encoding="UTF-8"?>
<!-- Orbit modifications: 2026-11-01 by Lucas Magotteaux; see NOTICE.md. -->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- menu bar app: no Dock icon, no app menu (the panel is the interface) -->
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>@BUNDLE_EXECUTABLE_NAME@</string>
	<key>CFBundleGetInfoString</key>
	<string>@BUNDLE_INFO_STRING@</string>
	<key>CFBundleIconFile</key>
	<string>@BUNDLE_ICON_FILE@</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleName</key>
	<string>@BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@BUNDLE_COPYRIGHT@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- Prevent macOS from terminating during memory pressure -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Local Lan Entitlements -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app uses local network permissions for communication between an @CMAKE_PROJECT_PROPER_NAME@ server and clients.</string>
	<!-- Bonjour: servers advertise, clients browse (see gui/OrbitDiscovery.h) -->
	<key>NSBonjourServices</key>
	<array>
		<string>_orbit._tcp</string>
	</array>
	<key>com.apple.security.networking.local</key>
	<true/>

	<!-- Accessibility Entitlements -->
	<key>com.apple.security.accessibility</key>
	<array>
		<dict>
			<key>com.apple.security.accessibility.read</key>
			<true/>
			<key>com.apple.security.accessibility.write</key>
			<true/>
			<key>com.apple.security.accessibility.execute</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
