#auto handle line feed
* text=auto eol=lf

# Preserve captured upstream license texts and recipes byte-for-byte, including
# their original whitespace and Markdown heading underlines.
third-party/** -text whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof conflict-marker-size=32

.gitattributes export-ignore
.gitignore export-ignore
.github* export-ignore
